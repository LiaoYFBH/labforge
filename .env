# ===== 主模型 LLM 配置 =====
# 主模型支持任何 OpenAI 兼容接口（MiniMax / 星河社区 / DeepSeek / 通义 / 智谱 等）。
# 实际生效的优先级：
#   1) UI / CLI 中保存的设置（.ui_settings.json）
#   2) 这里的 API_BASE_URL + MODEL_NAME + API_KEY
#   3) 内置默认（MiniMax-M2.7）
# 若使用 minimax / AI Studio / DeepSeek，可以分别填写 minimax_API_KEY / AI_STUDIO_API_KEY / deepseek_API_KEY，
# 系统会按 base_url & model 自动挑选最匹配的密钥。

LLM_PROVIDER=openai_compatible

# --- 选择 1: MiniMax ---
# API_BASE_URL=https://api.minimaxi.com/v1
# MODEL_NAME=MiniMax-M2.7
# minimax_API_KEY=sk-cp-xxxxxxxxxxxx

# --- 选择 2: 星河社区 (AI Studio) ---
# 支持 ERNIE / DeepSeek / Kimi / Qwen 等，base_url 一致
API_BASE_URL=https://aistudio.baidu.com/llm/lmapi/v3
AI_STUDIO_API_KEY=9202eca5d349064f1f473c19a1c3e5876ffe42ca

# --- 选择 3: 备用 minimax 密钥（保留以便快速切换） ---
minimax_API_KEY=sk-cp-jSoVpuXILZ5C5ZdYWG0rjGles2ySHKrMtcCL80N3-AWUm6-LldfbvR02BsE7A6dt5lcKOmTK5qK2PKd3v0AfA1W1QJ2lAocJH2NyYNlbHs7t-zY95UbP6sQ

# --- 通用回退 API_KEY（任何 base_url 都会用这个）---
# API_KEY=

# --- 其它兼容接口示例（按需取消注释） ---
# # 智谱 GLM
# API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# MODEL_NAME=glm-4-plus
# API_KEY=xxxxx.xxxxx
#
# # 通义千问
