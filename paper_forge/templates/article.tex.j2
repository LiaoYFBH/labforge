\hypersetup{
    colorlinks=true,
    linkcolor=black,
    citecolor=blue,
    urlcolor=blue,
}

\setstretch{((( line_spacing )))}
\setlength{\parindent}{1.5em}
\setlength{\parskip}{0.5ex}
\sloppy
\emergencystretch=2em
\allowdisplaybreaks
\captionsetup{font=small,labelfont=bf}

\title{((( title )))}
((* if authors *))
\author{((( authors|join(' \\and ') )))}
((* else *))
\author{}
((* endif *))
\date{}

\begin{document}
\maketitle

((* if abstract *))
\begin{abstract}
((( abstract )))
\end{abstract}
((* endif *))

((* if keywords *))
\noindent\textbf{((( labels.keywords ))):} ((( keywords|join(', ') )))
\vspace{1em}
((* endif *))

((* for section in sections *))
((* if section.level == 1 *))
\section{((( section.heading )))}
((* elif section.level == 2 *))
\subsection{((( section.heading )))}
((* else *))
\subsubsection{((( section.heading )))}
((* endif *))

((* for para in section.paragraphs *))
((( para )))

((* endfor *))

((* for fig in section.figures *))
((* if fig.rendered_path *))
\begin{figure}[H]
    \centering
    \includegraphics[width=0.8\linewidth]{((( fig.rendered_path )))}
    \caption{((( fig.caption )))}
\end{figure}
((* endif *))
((* endfor *))

((* for tbl in section.tables *))
((* if tbl.headers and tbl.rows *))
\begin{table}[H]
    \centering
    \caption{((( tbl.caption )))}
    \small
    \begin{tabular}{((( tbl.col_spec )))}
    \toprule
    ((( tbl.header_row ))) \\
    \midrule
    ((* for row_line in tbl.body_rows *))
    ((( row_line ))) \\
    ((* endfor *))
    \bottomrule
    \end{tabular}
\end{table}
((* endif *))
((* endfor *))

((* endfor *))

((* if references *))
\begin{thebibliography}{((( references|length )))}
((* for ref in references *))
\bibitem{ref((( loop.index )))} ((( ref )))
((* endfor *))
\end{thebibliography}
((* endif *))

\end{document}
