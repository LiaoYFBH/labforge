# ===== PaperForge 环境变量模板 =====
# 复制为 .env 并按需填写。.env 已在 .gitignore 中。

# ────────── 大模型 (用于把 OCR 结果重组为论文结构) ──────────
# 任何 OpenAI 兼容后端均可。

# 推荐: 星河社区 (AI Studio)
API_BASE_URL=https://aistudio.baidu.com/llm/lmapi/v3
MODEL_NAME=ernie-4.5-turbo-128k-preview
AI_STUDIO_API_KEY=

# 备用: MiniMax
# API_BASE_URL=https://api.minimaxi.com/v1
# MODEL_NAME=MiniMax-M2.7
# minimax_API_KEY=

# 通用回退
# API_KEY=

# ────────── PaddleOCR-VL ──────────
# 在星河社区 (AI Studio) 部署 PaddleOCR-VL 应用后，把推理 URL 和 access token 填这里。
PADDLEOCR_API_URL=
PADDLEOCR_TOKEN=
