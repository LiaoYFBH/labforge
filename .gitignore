# lab-forge-specific ignores. Root .gitignore covers most things;
# this file keeps a few project-local artefacts out of the index.

# Local UI settings (contains API keys when user saves them from the web UI)
.ui_settings.json

# Runtime outputs
trajectories/
test_trajectories/
sab_results/
sab_benchmark/
benchmark_results.json
lab-forge/research_paper (14).pdf
# Secrets
.envlab-forge/docs
lab-forge/evals
.env.*
env.txt

# Large benchmark assets — never commit (3.8GB benchmark dir, 1.7GB zip)
*.zip
benchmark/
benchmark.zip
=0.2.0

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/

# Local venv
.venv/

# pip placeholder files left over from mis-quoted `pip install`
=*
