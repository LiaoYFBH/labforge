# ===== SciPRM-Agent 环境变量模板 =====
# 复制为 .env 并按需填写。.env 已在 .gitignore 中，不会进入版本控制。

# ────────── 主模型 (任意 OpenAI 兼容后端) ──────────
# Pick ONE of the providers below: 取消对应的注释块并填上 API Key。

# 选项 1: 星河社区 (AI Studio) — 推荐，国内访问稳定，模型全
API_BASE_URL=https://aistudio.baidu.com/llm/lmapi/v3
MODEL_NAME=ernie-4.5-turbo-128k-preview
AI_STUDIO_API_KEY=

# 选项 2: MiniMax
# API_BASE_URL=https://api.minimaxi.com/v1
# MODEL_NAME=MiniMax-M2.7
# minimax_API_KEY=

# 选项 3: DeepSeek 官方
# API_BASE_URL=https://api.deepseek.com/v1
# MODEL_NAME=deepseek-chat
# deepseek_API_KEY=

# 选项 4: 智谱 GLM
# API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# MODEL_NAME=glm-4-plus
# API_KEY=

# 选项 5: 通义千问
# API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MODEL_NAME=qwen-plus
# API_KEY=

# 选项 6: Moonshot (Kimi)
# API_BASE_URL=https://api.moonshot.cn/v1
# MODEL_NAME=moonshot-v1-128k
# API_KEY=

# 选项 7: 本地 Ollama
# API_BASE_URL=http://localhost:11434/v1
# MODEL_NAME=qwen2.5:14b
# API_KEY=ollama

# 选项 8: OpenAI / Anthropic 等海外厂商
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# 通用回退 (任何 base_url 都会用这个)
# API_KEY=

# ────────── 评审模型 (可选，建议便宜模型) ──────────
# REVIEWER_MODEL=ernie-4.5-turbo-128k-preview
# REVIEWER_BASE_URL=https://aistudio.baidu.com/llm/lmapi/v3

# ────────── 沙箱执行 ──────────
# 留空时使用启动 sciprm_agent 的同一个 Python 解释器。
# 想让 execute_code 跑在另一个 conda env 里时填这里：
# SCIPRM_PYTHON_EXECUTABLE=/path/to/your/conda_env/bin/python

# ────────── 外部 API (可选) ──────────
# PaddleOCR-VL (扫描 PDF / 图片识别)
# PADDLEOCR_API_URL=https://your-aistudio-app.aistudio-app.com/layout-parsing
# PADDLEOCR_TOKEN=
#
# SerpAPI Google Scholar (覆盖 ML/CS 之外的会议/期刊；不填则只用 arXiv 免费搜索)
# 注册 https://serpapi.com/ 获取免费额度（每月 100 次）。也可以在 UI
# 的「Literature Search」面板填写，等同效果。
# SERPAPI_API_KEY=

# ────────── 部署相关 ──────────
# 多人共享部署（如星河社区 / AI Studio）建议关闭历史轨迹面板，
# 避免其他访客看到历次研究主题与产物。
# SCIPRM_SHOW_HISTORY=false
